---
import Base from "../layouts/Base.astro";
import { url } from "../lib/data";
---

<Base title="Page not found - shadcn-iced" description="This page does not exist.">
  <main class="mx-auto flex max-w-xl flex-col items-center gap-4 px-4 py-24 text-center">
    <p class="text-muted-foreground font-mono text-sm">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="text-muted-foreground">This page does not exist. The components are listed in the docs.</p>
    <a
      href={url("/docs/components")}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
    >
      Browse Components
    </a>
  </main>
</Base>
