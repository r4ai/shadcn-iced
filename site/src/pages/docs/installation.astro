---
import CodeBlock from "../../components/CodeBlock.astro";
import Docs from "../../layouts/Docs.astro";
import { url } from "../../lib/data";

const toc = [
  { id: "as-a-library", label: "As a library" },
  { id: "copy-and-paste", label: "Copy and paste" },
  { id: "fonts-and-icons", label: "Fonts and icons" },
];

const main = `use shadcn_iced::prelude::*;

#[derive(Debug, Clone)]
enum Message {
    Save,
}

fn view(_state: &()) -> iced::Element<'_, Message> {
    card()
        .title("Create project")
        .description("Deploy your new project in one-click.")
        .footer(button("Deploy").on_press(Message::Save))
        .width(350)
        .into()
}

fn main() -> iced::Result {
    iced::application(|| (), |_: &mut (), _: Message| {}, view)
        // Any shadcn/ui preset, e.g. zinc with the blue accent:
        .theme(|_: &()| shadcn_iced::theme::zinc(Mode::Dark).build())
        // Loads Geist, Inter and the Lucide icons.
        .shadcn_iced()
        .run()
}`;

const copied = `mod ui;

fn view(state: &State) -> iced::Element<'_, Message> {
    ui::button::button("Click me").on_press(Message::Click).into()
}`;
---

<Docs
  title="Installation"
  description="Add shadcn-iced to an iced 0.14 application, as a library or as source you own."
  toc={toc}
  prev={{ href: url("/docs"), label: "Introduction" }}
  next={{ href: url("/docs/theming"), label: "Theming" }}
>
  <h2 id="as-a-library">As a library</h2>
  <p>Add <code>iced</code> and <code>shadcn_iced</code> to your <code>Cargo.toml</code>:</p>
  <CodeBlock
    class="mt-4"
    lang="toml"
    title="Cargo.toml"
    code={`[dependencies]\niced = "0.14"\nshadcn_iced = { git = "https://github.com/r4ai/shadcn-iced" }`}
  />
  <p>Then import the prelude, pick a theme and load the bundled fonts:</p>
  <CodeBlock class="mt-4" code={main} title="src/main.rs" />

  <h2 id="copy-and-paste">Copy and paste</h2>
  <p>Install the CLI:</p>
  <CodeBlock class="mt-4" lang="sh" code="cargo install --git https://github.com/r4ai/shadcn-iced cargo-shadcn-iced" />
  <p>Then, in your project, add the dependencies and the components you want:</p>
  <CodeBlock
    class="mt-4"
    lang="sh"
    code={`cargo add iced --features advanced,canvas,image,svg\ncargo add shadcn_iced_core --git https://github.com/r4ai/shadcn-iced\ncargo shadcn-iced add button card dialog`}
  />
  <p>
    The components, and the components they use, are written to <code>src/ui/</code>, and <code>src/ui/mod.rs</code> is
    kept up to date. Declare the module and use them like any of your own code:
  </p>
  <CodeBlock class="mt-4" code={copied} title="src/main.rs" />

  <h2 id="fonts-and-icons">Fonts and icons</h2>
  <p>
    <code>.shadcn_iced()</code> loads Geist, Geist Mono, Inter and the Lucide icon font, and makes Geist the default font.
    Every Lucide icon is a constant of <code>shadcn_iced::lucide</code>, e.g. <code>lucide::ARROW_UP</code>.
  </p>
</Docs>
