---
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import Docs from "../../../layouts/Docs.astro";
import { components, githubUrl, moduleName, url, type Component } from "../../../lib/data";

export function getStaticPaths() {
  return components.map((component, index) => ({
    params: { id: component.id },
    props: { component, prev: components[index - 1], next: components[index + 1] },
  }));
}

interface Props {
  component: Component;
  prev?: Component;
  next?: Component;
}

const { component, prev, next } = Astro.props;
const [demo, ...examples] = component.examples;
const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const module = moduleName(component.id);

const toc = [
  { id: "installation", label: "Installation" },
  ...(examples.length ? [{ id: "examples", label: "Examples" }] : []),
  ...examples.map((example) => ({ id: slug(example.title), label: example.title, depth: 3 })),
];

const link = (c?: Component) => c && { href: url(`/docs/components/${c.id}`), label: c.title };
const tab =
  "text-muted-foreground relative h-9 px-1 text-sm font-medium transition-colors hover:text-foreground aria-selected:text-foreground after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 aria-selected:after:bg-foreground";
---

<Docs title={component.title} description={component.description} toc={toc} prev={link(prev)} next={link(next)}>
  {demo && <ComponentPreview page={component.id} example={demo} />}

  <h2 id="installation">Installation</h2>
  <div data-tabs class="mt-4 flex flex-col gap-4">
    <div role="tablist" class="flex items-center gap-4 border-b">
      <button type="button" role="tab" data-tab="cli" aria-selected="true" class={tab}>CLI</button>
      <button type="button" role="tab" data-tab="library" aria-selected="false" class={tab}>Library</button>
      {component.source && <button type="button" role="tab" data-tab="manual" aria-selected="false" class={tab}>Manual</button>}
    </div>
    <div data-panel="cli" data-active="true" class="data-[active=false]:hidden">
      <p>Copy the component, and the components it uses, into <code>src/ui/</code>:</p>
      <CodeBlock class="mt-4" lang="sh" code={`cargo shadcn-iced add ${component.id}`} />
    </div>
    <div data-panel="library" data-active="false" class="data-[active=false]:hidden">
      <p>Or use it from the <code>shadcn_iced</code> crate:</p>
      <CodeBlock
        class="mt-4"
        lang="rust"
        code={`use shadcn_iced::${module}::*;\n// or everything at once:\nuse shadcn_iced::prelude::*;`}
      />
    </div>
    {
      component.source && (
        <div data-panel="manual" data-active="false" class="data-[active=false]:hidden">
          <p>
            Copy the source of the component into <code>src/ui/{module}.rs</code> (it uses{" "}
            <code>shadcn_iced_core</code> and, sometimes, other components):
          </p>
          <CodeBlock class="mt-4" code={component.source.code} title={component.source.file} expandable />
          <p>
            <a href={githubUrl(component.source.file)} target="_blank" rel="noreferrer">
              View it on GitHub
            </a>
          </p>
        </div>
      )
    }
  </div>

  {
    examples.length > 0 && (
      <>
        <h2 id="examples">Examples</h2>
        {examples.map((example) => (
          <section class="mt-10 first-of-type:mt-6">
            <h3 id={slug(example.title)} class="!mt-0 mb-4">
              {example.title}
            </h3>
            <ComponentPreview page={component.id} example={example} />
          </section>
        ))}
      </>
    )
  }
</Docs>
