---
import Docs from "../../../layouts/Docs.astro";
import { components, url } from "../../../lib/data";
---

<Docs
  title="Components"
  description={`${components.length} components ported from shadcn/ui, each with live previews running in your browser.`}
>
  <div class="not-prose grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
    {
      components.map((component) => (
        <a
          href={url(`/docs/components/${component.id}`)}
          class="not-prose hover:text-foreground text-foreground/80 flex items-baseline justify-between gap-2 border-b border-dashed py-2 text-sm transition-colors"
        >
          <span class="font-medium">{component.title}</span>
          <span class="text-muted-foreground text-xs tabular-nums">
            {component.examples.length} {component.examples.length === 1 ? "example" : "examples"}
          </span>
        </a>
      ))
    }
  </div>
</Docs>
