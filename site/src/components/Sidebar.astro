---
import { components, url } from "../lib/data";

const path = Astro.url.pathname.replace(/\/$/, "");
const sections = [
  {
    title: "Getting Started",
    items: [
      { href: url("/docs"), label: "Introduction" },
      { href: url("/docs/installation"), label: "Installation" },
      { href: url("/docs/theming"), label: "Theming" },
    ],
  },
  {
    title: "Components",
    items: components.map((component) => ({
      href: url(`/docs/components/${component.id}`),
      label: component.title,
    })),
  },
];
---

<nav class="flex flex-col gap-6 pb-10 text-sm">
  {
    sections.map((section) => (
      <div class="flex flex-col gap-1">
        <p class="text-muted-foreground px-2 pb-1 text-xs font-medium">{section.title}</p>
        {section.items.map((item) => {
          const active = path === item.href.replace(/\/$/, "");
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "hover:bg-accent rounded-md px-2 py-1 transition-colors",
                active ? "bg-accent text-foreground font-medium" : "text-foreground/80",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    ))
  }
</nav>
