---
// An example with Preview and Code tabs, like the `<ComponentPreview>` of
// shadcn/ui.
import type { Example } from "../lib/data";
import { githubUrl, minHeight } from "../lib/data";
import CodeBlock from "./CodeBlock.astro";
import PreviewFrame from "./PreviewFrame.astro";

interface Props {
  page: string;
  example: Example;
}

const { page, example } = Astro.props;
const tab =
  "data-[state=active]:text-foreground text-muted-foreground relative h-9 px-1 text-sm font-medium transition-colors hover:text-foreground aria-selected:text-foreground after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-transparent aria-selected:after:bg-foreground";
---

<div data-tabs class="group/tabs flex flex-col gap-2">
  <div class="flex items-center justify-between border-b">
    <div role="tablist" class="flex items-center gap-4">
      <button type="button" role="tab" data-tab="preview" aria-selected="true" class={tab}>Preview</button>
      <button type="button" role="tab" data-tab="code" aria-selected="false" class={tab}>Code</button>
    </div>
    <a
      href={githubUrl(example.file, example.line)}
      class="text-muted-foreground hover:text-foreground font-mono text-xs"
      target="_blank"
      rel="noreferrer"
    >
      {example.file.split("/").pop()}:{example.line}
    </a>
  </div>
  <div class="relative">
    <div
      data-panel="preview"
      data-active="true"
      class="overflow-hidden rounded-xl border data-[active=false]:pointer-events-none data-[active=false]:invisible data-[active=false]:absolute data-[active=false]:inset-x-0 data-[active=false]:top-0"
    >
      <PreviewFrame page={page} example={example.index} minHeight={minHeight(page)} />
    </div>
    <div data-panel="code" data-active="false" class="data-[active=false]:hidden">
      <CodeBlock code={example.code} />
    </div>
  </div>
</div>
