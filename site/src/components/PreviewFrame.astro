---
// A live preview: iced replaces the target element with its canvas once the
// frame comes into view (see `scripts/previews.ts`).
import Icon from "./Icon.astro";

interface Props {
  page: string;
  example: number;
  minHeight: number;
  class?: string;
}

const { page, example, minHeight, class: className } = Astro.props;
const target = `preview-${page}-${example}`;
---

<div
  data-preview
  data-page={page}
  data-example={example}
  data-target={target}
  data-min-height={minHeight}
  data-state="idle"
  class:list={["group/preview bg-background relative w-full overflow-hidden", className]}
  style={`height: ${minHeight}px`}
>
  <div
    class="text-muted-foreground absolute inset-0 flex flex-col items-center justify-center gap-2 text-xs group-data-[state=error]/preview:hidden"
    aria-hidden="true"
  >
    <svg class="preview-spinner size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"></path>
    </svg>
    Loading preview
  </div>
  <div
    class="text-muted-foreground absolute inset-0 hidden flex-col items-center justify-center gap-2 p-6 text-center text-sm group-data-[state=error]/preview:flex"
  >
    <Icon name="triangle-alert" size={18} />
    <p>The live preview could not start in this browser.</p>
  </div>
  <div id={target}></div>
</div>
