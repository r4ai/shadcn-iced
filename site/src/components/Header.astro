---
import { REPOSITORY, url } from "../lib/data";
import Icon from "./Icon.astro";
import ThemeMenu from "./ThemeMenu.astro";

const path = Astro.url.pathname;
const links = [
  { href: url("/docs"), label: "Docs", active: path.includes("/docs") && !path.includes("/docs/components") && !path.includes("/docs/theming") },
  { href: url("/docs/components"), label: "Components", active: path.includes("/docs/components") },
  { href: url("/docs/theming"), label: "Theming", active: path.includes("/docs/theming") },
];
---

<header class="bg-background/90 sticky top-0 z-40 w-full border-b backdrop-blur supports-[backdrop-filter]:bg-background/70">
  <div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-4 px-4 sm:px-6">
    <a href={url("/")} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="bg-primary text-primary-foreground grid size-6 place-items-center rounded-md">
        <Icon name="command" size={14} />
      </span>
      iced-ui
    </a>
    <nav class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-md px-2.5 py-1.5 text-sm transition-colors hover:text-foreground",
              link.active ? "text-foreground font-medium" : "text-muted-foreground",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <ThemeMenu />
      <a
        href={REPOSITORY}
        class="hover:bg-accent grid size-8 place-items-center rounded-md transition-colors"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub repository"
      >
        <Icon name="github" size={16} />
      </a>
      <button
        type="button"
        data-mode-toggle
        class="hover:bg-accent grid size-8 place-items-center rounded-md transition-colors"
        aria-label="Toggle dark mode"
      >
        <span class="dark:hidden"><Icon name="moon" size={16} /></span>
        <span class="hidden dark:inline"><Icon name="sun" size={16} /></span>
      </button>
    </div>
  </div>
</header>
