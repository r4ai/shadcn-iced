---
import { Code } from "astro:components";
import Icon from "./Icon.astro";

interface Props {
  code: string;
  lang?: string;
  /** A file name or label shown above the code. */
  title?: string;
  /** Collapses long code to a few lines, with a button to expand it. */
  expandable?: boolean;
  class?: string;
}

const { code, lang = "rust", title, expandable = false, class: className } = Astro.props;
const long = expandable && code.split("\n").length > 16;
---

<div
  class:list={["group/code bg-code relative overflow-hidden rounded-xl border", className]}
  data-copy-scope
  data-expandable={long ? "" : undefined}
  data-expanded="false"
>
  {
    title && (
      <div class="text-muted-foreground flex h-10 items-center border-b px-4 font-mono text-xs">
        {title}
      </div>
    )
  }
  <button
    type="button"
    data-copy
    class:list={[
      "text-muted-foreground hover:bg-accent hover:text-foreground absolute right-2 z-10 grid size-7 place-items-center rounded-md transition-colors",
      title ? "top-1.5" : "top-2",
    ]}
    aria-label="Copy code"
  >
    <span class="group-has-[[data-copied]]/code:hidden"><Icon name="copy" size={14} /></span>
    <span class="hidden group-has-[[data-copied]]/code:inline"><Icon name="check" size={14} /></span>
  </button>
  <div
    data-copy-source
    class:list={[
      "overflow-x-auto px-4 py-3.5 [&_pre]:!m-0",
      long && "max-h-80 overflow-y-hidden group-data-[expanded=true]/code:max-h-[none]",
      !long && "max-h-[640px] overflow-y-auto",
    ]}
  >
    <Code code={code} lang={lang as any} themes={{ light: "github-light", dark: "github-dark-default" }} />
  </div>
  {
    long && (
      <div class="from-code pointer-events-none absolute inset-x-0 bottom-0 flex h-24 items-end justify-center bg-gradient-to-t to-transparent pb-4 group-data-[expanded=true]/code:static group-data-[expanded=true]/code:h-auto group-data-[expanded=true]/code:bg-none">
        <button
          type="button"
          data-expand
          class="bg-background hover:bg-accent pointer-events-auto rounded-md border px-3 py-1.5 text-xs font-medium shadow-xs"
        >
          <span class="group-data-[expanded=true]/code:hidden">Expand</span>
          <span class="hidden group-data-[expanded=true]/code:inline">Collapse</span>
        </button>
      </div>
    )
  }
</div>
