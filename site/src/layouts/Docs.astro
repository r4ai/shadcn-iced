---
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  description: string;
  /** The sections of the page, for the "On this page" list. */
  toc?: { id: string; label: string; depth?: number }[];
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
}

const { title, description, toc = [], prev, next } = Astro.props;
---

<Base title={`${title} - shadcn-iced`} description={description}>
  <div class="mx-auto flex max-w-screen-2xl px-4 sm:px-6">
    <aside class="sticky top-14 hidden h-[calc(100svh-3.5rem)] w-56 shrink-0 overflow-y-auto py-8 pr-4 md:block">
      <Sidebar />
    </aside>
    <main class="min-w-0 flex-1 py-8 md:pl-6 lg:pl-10 xl:flex xl:gap-10">
      <div class="min-w-0 flex-1 xl:max-w-3xl">
        <details class="group/menu mb-6 rounded-lg border md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium">
            <Icon name="menu" size={16} />
            Menu
          </summary>
          <div class="max-h-[60svh] overflow-y-auto border-t px-1 pt-3">
            <Sidebar />
          </div>
        </details>
        <div class="flex flex-col gap-2">
          <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight text-balance">{title}</h1>
          <p class="text-muted-foreground text-base text-balance">{description}</p>
        </div>
        <div class="prose-docs mt-8">
          <slot />
        </div>
        {
          (prev || next) && (
            <div class="mt-16 flex items-center justify-between gap-4 border-t pt-6 text-sm">
              {prev ? (
                <a
                  href={prev.href}
                  class="hover:bg-accent inline-flex h-8 items-center gap-1 rounded-md border px-3 font-medium transition-colors"
                >
                  <Icon name="chevron-left" size={14} />
                  {prev.label}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  href={next.href}
                  class="hover:bg-accent inline-flex h-8 items-center gap-1 rounded-md border px-3 font-medium transition-colors"
                >
                  {next.label}
                  <Icon name="chevron-right" size={14} />
                </a>
              )}
            </div>
          )
        }
      </div>
      {
        toc.length > 0 && (
          <aside class="sticky top-22 hidden h-fit w-48 shrink-0 text-sm xl:block">
            <p class="mb-3 text-xs font-medium">On This Page</p>
            <ul class="flex flex-col gap-2">
              {toc.map((item) => (
                <li class:list={[item.depth === 3 && "pl-3"]}>
                  <a href={`#${item.id}`} class="text-muted-foreground hover:text-foreground transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </main>
  </div>
</Base>
