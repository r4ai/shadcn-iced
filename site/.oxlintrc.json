{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "jsx-a11y", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    // Spreading the items of a small list reads better than mutating them.
    "oxc/no-map-spread": "off"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "src/data/", "public/wasm/", "dist/"]
}
