// Cloudflare Workers static assets: the prerendered pages of `dist/client`,
// without a Worker script (`dist/server` is the build-time renderer).
// Deployed from `main` by the `Deploy site` job of `ci.yml` (`wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadcn-iced",
  "compatibility_date": "2026-10-01",
  // Served only on the custom domain shadcn-iced.r4ai.dev. It is not listed in
  // `routes`: adding or changing it needs a token with Workers Routes Write on
  // the zone, so it is set up once in the dashboard (Domains & Routes), and
  // deploys only need Editor on the Worker.
  "workers_dev": false,
  "preview_urls": false,
  // Worker Previews of pull requests (`wrangler preview`, `Preview site` of
  // `ci.yml`), served on pr-<number>.shadcn-iced.r4ai.dev: the custom domain
  // is enabled for "Production and Preview" in the dashboard, where it is
  // managed, and Cloudflare issues the wildcard DNS record and certificate.
  // Assets-only, the previews override nothing.
  "previews": {},
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
