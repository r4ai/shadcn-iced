// Cloudflare Workers static assets: the built site, without a Worker script.
// Deployed by the `Site` workflow (`pnpm run deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadcn-iced",
  "compatibility_date": "2026-10-01",
  // Served only on the custom domain shadcn-iced.r4ai.dev. It is not listed in
  // `routes`: adding or changing it needs a token with Workers Routes Write on
  // the zone, so it is set up once in the dashboard (Domains & Routes), and
  // deploys only need Editor on the Worker.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
