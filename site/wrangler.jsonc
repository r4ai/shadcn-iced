// Cloudflare Workers static assets: the built site, without a Worker script.
// Deployed by the `Site` workflow (`pnpm run deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iced-ui",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
