{
  "$schema": "./schema.json",
  "component": "input-otp",
  "scenarios": [
    {
      "id": "default",
      "viewport": [260, 64],
      "steps": [
        { "snapshot": "idle" },
        { "click": { "at": [32, 32] } },
        { "snapshot": "focused" },
        { "type": "123" },
        { "expect": { "visible": ["1", "2", "3"], "hidden": ["4"] } },
        { "snapshot": "partial" },
        { "type": "456" },
        { "expect": { "visible": ["4", "5", "6"] } },
        { "snapshot": "full" },
        { "press": "Backspace" },
        { "expect": { "hidden": ["6"], "visible": ["5"] } },
        { "snapshot": "backspace" }
      ]
    },
    { "id": "value", "viewport": [200, 64] },
    { "id": "invalid", "viewport": [260, 64] },
    { "id": "disabled", "viewport": [260, 64] }
  ]
}
