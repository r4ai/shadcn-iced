{
  "$schema": "./schema.json",
  "component": "alert",
  "scenarios": [
    {
      "id": "default",
      "viewport": [480, 200],
      "steps": [
        {
          "expect": {
            "visible": ["Payment successful", "New feature available"]
          }
        },
        { "snapshot": "default" }
      ]
    },
    { "id": "destructive", "viewport": [480, 100] },
    {
      "id": "action",
      "viewport": [480, 90],
      "steps": [
        { "expect": { "visible": ["Dark mode is now available", "Enable"] } },
        { "snapshot": "idle" },
        { "hover": "Enable" },
        { "snapshot": "hover-action" }
      ]
    }
  ]
}
